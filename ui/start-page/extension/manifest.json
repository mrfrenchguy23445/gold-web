{
  "manifest_version": 3,
  "name": "Gold-Web Start",
  "description": "The Gold-Web start page and new-tab experience.",
  "version": "0.1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "start@goldweb.browser",
      "strict_min_version": "128.0"
    }
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["search", "storage", "bookmarks"]
}
