# Gold-Web — Linux build configuration.
#
# scripts/build.sh copies this into the Firefox tree as `mozconfig`.
# The object directory lives inside the Firefox checkout, never in this repo.

mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-goldweb

ac_add_options --enable-application=browser

# Separate product identity, and a profile directory that won't collide with
# an installed Firefox.
ac_add_options --with-app-basename=Gold-Web

ac_add_options --enable-optimize

# Compilation cache (installed at ~/.local/bin/sccache). Makes iterative
# rebuilds much cheaper for both C/C++ and Rust.
ac_add_options --with-ccache=sccache

# Mozilla's downloaded toolchain ships lld, which links noticeably faster.
ac_add_options --enable-linker=lld

# Shipping builds are slower to compile but faster to run. Uncomment for a
# release build.
# ac_add_options --enable-release
# ac_add_options --disable-tests

# The brand itself comes from the patch that points MOZ_BRANDING_DIRECTORY at
# browser/branding/goldweb (applied by scripts/apply.sh).
